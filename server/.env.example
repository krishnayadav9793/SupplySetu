PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase / PostgreSQL Database Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
DATABASE_URL="postgresql://postgres:your_password@your-host.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_password@your-host.supabase.com:5432/postgres"

# JWT Authentication
JWT_SECRET="supplysetu_secret_key_change_in_production"

# Gemini AI (Optional if using live Gemini extraction)
GEMINI_API_KEY=""
